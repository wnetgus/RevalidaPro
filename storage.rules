rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /imagens-prova/{imageName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.token.email == "drweynesouza@gmail.com"
            || request.auth.token.email == "wnetgus@gmail.com");
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
